DEEPGRAM_API_KEY=
# Public origin, without a path. Set the isolated staging URL in staging only.
NEXT_PUBLIC_SITE_URL=https://oraiservice.com
# Enable only on the official production site; leave false for staging/local.
# Both public variables are build-time settings and require a rebuild.
NEXT_PUBLIC_SITE_INDEXING=false
ELEVENLABS_API_KEY=
JEV_API_KEY=
OPENROUTER_API_KEY=

# Supabase project URL. This value is public. The service role key stays on the server.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Both dashboards use Supabase Auth email/password and database roles.
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY may replace the publishable key above.
# ADMIN_PASSWORD and SESSION_SECRET are not used by the current auth flow.

# Server-only signing secret generated by ElevenLabs webhook settings
ELEVENLABS_WEBHOOK_SECRET=

# Server-side secret authenticating ONLY the Orai marketing agent (ORAI_MARKETING_AGENT_ID)
# for the create_message Server Tool (merchant agents use per-agent credentials in DB).
ELEVENLABS_MARKETING_TOOL_SECRET=

# Legacy alias for ELEVENLABS_MARKETING_TOOL_SECRET (marketing agent only)
ELEVENLABS_SERVER_TOOL_SECRET=

# Orai marketing website ElevenLabs agent ID routed to the Orai Admin message inbox
ORAI_MARKETING_AGENT_ID=agent_8201m7sbetj3e36s1a2nv3fgcqna

# Meta WhatsApp Cloud API (Staging / backend-only secrets; never commit real values)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_APP_ID=
WHATSAPP_BUSINESS_ID=
WHATSAPP_GRAPH_API_VERSION=v25.0
